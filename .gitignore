# Python cache and bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
ENV/

# Environment files and secrets
.env
.env.*

# OS / editor files
.DS_Store
.vscode/

# Uploads and generated files
static/uploads/*
